# shellcheck shell=bash
# Evermeet_return_prompt.bgptheme - Two-line box-drawn Retina theme with emoji status icons

GIT_PROMPT_THEME_NAME="Evermeet_return_prompt"

GIT_PROMPT_PREFIX="🪵 "
GIT_PROMPT_SUFFIX=""
GIT_PROMPT_SEPARATOR=" "
GIT_PROMPT_BRANCH="${Magenta}"
GIT_PROMPT_UPSTREAM=" {${Magenta}_UPSTREAM_${ResetColor}}"
GIT_PROMPT_STAGED="${Red}👆"
GIT_PROMPT_CONFLICTS="${Red}😨"
GIT_PROMPT_CHANGED="${Blue}⌛"
GIT_PROMPT_UNTRACKED="${Cyan}🤔"
GIT_PROMPT_STASHED="${BoldBlue}📌"
GIT_PROMPT_CLEAN="${BoldGreen}👍"

GIT_PROMPT_COMMAND_OK="${BoldGreen}0"
GIT_PROMPT_COMMAND_FAIL="${BoldYellow}_LAST_COMMAND_STATE_"

GIT_PROMPT_SYMBOLS_BEHIND="👇"
GIT_PROMPT_SYMBOLS_NO_REMOTE_TRACKING="🔥"

GIT_PROMPT_START_USER="┌──[${Time12a} ${Green}\\u${ResetColor} _LAST_COMMAND_INDICATOR_ ${BoldBlue}${PathShort}${ResetColor}"
GIT_PROMPT_START_ROOT="┌──[${Red}\\u${ResetColor} _LAST_COMMAND_INDICATOR_ ${BoldBlue}${PathShort}${ResetColor}"
GIT_PROMPT_END_USER="]\n└─$ "
GIT_PROMPT_END_ROOT="]\n└─# "
