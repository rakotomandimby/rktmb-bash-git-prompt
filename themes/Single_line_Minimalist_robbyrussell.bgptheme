# shellcheck shell=bash
# Single_line_Minimalist_robbyrussell.bgptheme - Inspired by oh-my-zsh robbyrussell

GIT_PROMPT_THEME_NAME="Single_line_Minimalist_robbyrussell"

prompt_callback() {
  gp_set_window_title "$(gp_truncate_pwd)"
}

PathShort="\W"

GIT_PROMPT_COMMAND_OK="${BoldGreen}➜"
GIT_PROMPT_COMMAND_FAIL="${BoldRed}➜"

GIT_PROMPT_START_USER="_LAST_COMMAND_INDICATOR_  ${BoldCyan}${PathShort}${ResetColor}"
GIT_PROMPT_START_ROOT="${GIT_PROMPT_START_USER}"
GIT_PROMPT_END_USER=" "
GIT_PROMPT_END_ROOT=" # "
