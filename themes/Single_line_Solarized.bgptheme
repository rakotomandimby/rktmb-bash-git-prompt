# shellcheck shell=bash
# Single_line_Solarized.bgptheme - Single-line theme tuned for Solarized Dark/Light

GIT_PROMPT_THEME_NAME="Single_line_Solarized"

PathShort="\W"

GIT_PROMPT_PREFIX="[ "
GIT_PROMPT_SUFFIX=" ]"
GIT_PROMPT_SEPARATOR=" | "
GIT_PROMPT_BRANCH="${Magenta}"
GIT_PROMPT_STAGED="${Yellow}● "
GIT_PROMPT_CONFLICTS="${Red}✖ "
GIT_PROMPT_CHANGED="${Blue}✚ "
GIT_PROMPT_UNTRACKED="${Cyan}… "
GIT_PROMPT_STASHED="${BoldMagenta}⚑ "
GIT_PROMPT_CLEAN="${Green}✔"

GIT_PROMPT_COMMAND_OK="${Green}✔"
GIT_PROMPT_COMMAND_FAIL="${Red}✘"

GIT_PROMPT_SYMBOLS_NO_REMOTE_TRACKING="✭"

GIT_PROMPT_START_USER="_LAST_COMMAND_INDICATOR_ ${Yellow}\\u:${Cyan}${PathShort}${ResetColor}"
GIT_PROMPT_START_ROOT="_LAST_COMMAND_INDICATOR_ ${Red}\\u:${Cyan}${PathShort}${ResetColor}"
GIT_PROMPT_END_USER="${BoldBlue} ➭ ${ResetColor}"
GIT_PROMPT_END_ROOT="${BoldRed} # ${ResetColor}"
