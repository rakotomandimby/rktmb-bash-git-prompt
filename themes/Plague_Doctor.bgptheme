# shellcheck shell=bash
# Plague_Doctor.bgptheme - Repository-only Nerd Font two-line theme

GIT_PROMPT_THEME_NAME="Plague_Doctor"

GIT_PROMPT_ONLY_IN_REPO=1
GIT_PROMPT_LEADING_SPACE=0

GIT_PROMPT_PREFIX="[ "
GIT_PROMPT_SUFFIX=" ]"
GIT_PROMPT_SEPARATOR=" | "
GIT_PROMPT_SYMBOLS_NO_REMOTE_TRACKING="✭"

GIT_PROMPT_START_USER="${BoldBlue} ${ResetColor}"
GIT_PROMPT_START_ROOT="${BoldRed}❖ ${ResetColor}"
GIT_PROMPT_END_USER="\n_LAST_COMMAND_INDICATOR_ ${White}${Time12a}${ResetColor} ${Green}\\u@\\h${ResetColor} ${Yellow}${PathShort}${ResetColor} $ "
GIT_PROMPT_END_ROOT="\n_LAST_COMMAND_INDICATOR_ ${White}${Time12a}${ResetColor} ${BoldRed}\\u@\\h${ResetColor} ${Yellow}${PathShort}${ResetColor} ${BoldRed}# ${ResetColor}"
