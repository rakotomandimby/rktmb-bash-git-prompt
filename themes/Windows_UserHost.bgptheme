# shellcheck shell=bash
# Windows_UserHost.bgptheme - Pure ASCII variant of Solarized_UserHost using 24-bit RGB colors

GIT_PROMPT_THEME_NAME="Windows_UserHost"

LightBlue='\[\033[38;2;114;159;207m\]'
CrimsonRed='\[\033[38;2;220;20;60m\]'

GIT_PROMPT_PREFIX="${Cyan}["
GIT_PROMPT_SUFFIX="${Cyan}]"
GIT_PROMPT_SEPARATOR="|"
GIT_PROMPT_BRANCH="${Magenta}"
GIT_PROMPT_STAGED="${Yellow}* "
GIT_PROMPT_CONFLICTS="${CrimsonRed}x "
GIT_PROMPT_CHANGED="${LightBlue}+ "
GIT_PROMPT_UNTRACKED="${Cyan}.. "
GIT_PROMPT_STASHED="${BoldMagenta}S "
GIT_PROMPT_CLEAN="${Green}v "

GIT_PROMPT_COMMAND_OK="${Green}v "
GIT_PROMPT_COMMAND_FAIL="${CrimsonRed}x "

GIT_PROMPT_SYMBOLS_AHEAD="^."
GIT_PROMPT_SYMBOLS_BEHIND="v."
GIT_PROMPT_SYMBOLS_NO_REMOTE_TRACKING="L"

GIT_PROMPT_START_USER="_LAST_COMMAND_INDICATOR_${Yellow}${PathShort}${ResetColor}"
GIT_PROMPT_START_ROOT="${GIT_PROMPT_START_USER}"
GIT_PROMPT_END_USER="\n${LightBlue}\\u@\\h > ${ResetColor}"
GIT_PROMPT_END_ROOT="\n${CrimsonRed}\\u@\\h # ${ResetColor}"
