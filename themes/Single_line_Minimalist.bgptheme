# shellcheck shell=bash
# Single_line_Minimalist.bgptheme - Compact single-line prompt with window title & basename

GIT_PROMPT_THEME_NAME="Single_line_Minimalist"

prompt_callback() {
  gp_set_window_title "$(gp_truncate_pwd)"
}

PathShort="\W"

GIT_PROMPT_PREFIX="["
GIT_PROMPT_SUFFIX="]"
GIT_PROMPT_SEPARATOR=" "
GIT_PROMPT_STAGED=" ${Red}●"
GIT_PROMPT_CONFLICTS=" ${Red}✖"
GIT_PROMPT_CHANGED=" ${Blue}✚"
GIT_PROMPT_UNTRACKED=" ${Cyan}…"
GIT_PROMPT_STASHED=" ${BoldBlue}⚑"
GIT_PROMPT_CLEAN=" ${BoldGreen}✔"

GIT_PROMPT_COMMAND_OK="${Green}✔"
GIT_PROMPT_COMMAND_FAIL="${Red}✘"

GIT_PROMPT_START_USER="_LAST_COMMAND_INDICATOR_ ${White}\\t${ResetColor} ${Cyan}${PathShort}${ResetColor}"
GIT_PROMPT_START_ROOT="${GIT_PROMPT_START_USER}"
GIT_PROMPT_END_USER=" $ "
GIT_PROMPT_END_ROOT=" # "
