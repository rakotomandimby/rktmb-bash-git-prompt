# shellcheck shell=bash
# Custom.bgptemplate - Template for ~/.git-prompt-colors.sh
#
# Copy this file to ~/.git-prompt-colors.sh (or run `git_prompt_make_custom_theme`)
# and set `GIT_PROMPT_THEME=Custom` in your ~/.bashrc.
# Any variable left commented out automatically inherits the Default theme value.

GIT_PROMPT_THEME_NAME="Custom"

# Time12a="\A"
# PathShort="\w"
# NewLine="\n"

# GIT_PROMPT_PREFIX="["                 # start of the git info string
# GIT_PROMPT_SUFFIX="]"                 # the end of the git info string
# GIT_PROMPT_SEPARATOR="|"              # separates each item

# GIT_PROMPT_BRANCH="${Magenta}"        # the git branch that is active in the current directory
# GIT_PROMPT_MASTER_BRANCH="${GIT_PROMPT_BRANCH}" # used if the git branch matches GIT_PROMPT_MASTER_BRANCHES
# GIT_PROMPT_MASTER_BRANCHES="master"   # pattern matching primary branch names (e.g. '@(master|main)')
# GIT_PROMPT_DETACHED_HEAD="${GIT_PROMPT_BRANCH}" # used if the git branch is in detached HEAD state

# GIT_PROMPT_STAGED="${Red}● "          # the number of staged files/directories
# GIT_PROMPT_CONFLICTS="${Red}✖ "       # the number of files in conflict
# GIT_PROMPT_CHANGED="${Blue}✚ "        # the number of changed files

# GIT_PROMPT_REMOTE=" "                 # the remote branch name (if any) and the symbols for ahead and behind
# GIT_PROMPT_UPSTREAM=" {${Blue}_UPSTREAM_${ResetColor}}" # template for upstream tracking branch
# GIT_PROMPT_UNTRACKED="${Cyan}…"       # the number of untracked files/dirs
# GIT_PROMPT_STASHED="${BoldBlue}⚑ "    # the number of stashed files/dir
# GIT_PROMPT_CLEAN="${BoldGreen}✔"      # a colored flag indicating a "clean" repo

# GIT_PROMPT_COMMAND_OK="${Green}✔"     # indicator if the last command returned with an exit code of 0
# GIT_PROMPT_COMMAND_FAIL="${Red}✘-_LAST_COMMAND_STATE_" # indicator if the last command returned with a non-zero exit code

# GIT_PROMPT_VIRTUALENV="(${Blue}_VIRTUALENV_${ResetColor}) " # template for active Python/Node/Conda virtual environments

# GIT_PROMPT_START_USER="_LAST_COMMAND_INDICATOR_ ${Yellow}${PathShort}${ResetColor}"
# GIT_PROMPT_START_ROOT="${GIT_PROMPT_START_USER}"
# GIT_PROMPT_END_USER=" \n${White}${Time12a}${ResetColor} $ "
# GIT_PROMPT_END_ROOT=" \n${White}${Time12a}${ResetColor} # "

# GIT_PROMPT_SYMBOLS_AHEAD="↑·"         # The symbol for "n versions ahead of origin"
# GIT_PROMPT_SYMBOLS_BEHIND="↓·"        # The symbol for "n versions behind of origin"
# GIT_PROMPT_SYMBOLS_PREHASH=":"        # Written before hash of commit, if no name could be found
# GIT_PROMPT_SYMBOLS_PRETAG=""          # Written before tag name in detached HEAD
# GIT_PROMPT_SYMBOLS_NO_REMOTE_TRACKING="L" # Added after branch name if the branch is not tracked
